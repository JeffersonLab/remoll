        <solidref ref="GEM_detector_solid_plane12"/>
        <auxiliary auxtype="SensDet" auxvalue="GEMSD" />
        <auxiliary auxtype="DetNo" auxvalue="300"/>
        <auxiliary auxtype="Color" auxvalue="green"/>
    </volume>

    <volume name="GEM_detector_log_1">
