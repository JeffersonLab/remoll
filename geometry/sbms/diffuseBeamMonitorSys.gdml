<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE gdml [
	<!ENTITY matrices SYSTEM "showerMaxMatrices.xml">
	<!ENTITY materials SYSTEM "showerMaxMaterials.xml">
    ]>

<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">


<define>
    <constant name="detBox_inner_radius" value="1400"/> <!--Radial location of LAM radiator from Moller-doc-948-v1-->
    <constant name="detBox_outer_radius" value="2000"/>



    &matrices;
</define>

&materials;

<solids>
    <tube name="solid_DBM_boundingBox" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin="0.99*(detBox_inner_radius - 10)" rmax="1.01*detBox_outer_radius" z="1.01*210"/>
    <tube name="solid_DBM_singleDet_boundingBox" lunit="mm" aunit="rad" startphi="-pi/(14*2)" deltaphi="pi/14" rmin="detBox_inner_radius - 10" rmax="detBox_outer_radius" z="210"/>

    <!--Radiator and PMT-->
    <box lunit="mm" name="solid_DBM_radiator_quartz" x="100" y="76" z="10"/>
    <tube name="solid_DBM_pmt_window" rmin="0" rmax="38.1" z="3.0" deltaphi="2*pi" startphi="0" aunit="rad" lunit="mm"/>
    <tube name="solid_DBM_pmt_cathode" rmin="0" rmax="38.1" z="3e-06" deltaphi="2*pi" startphi="0" aunit="rad" lunit="mm"/>

    <!--PMT Housing-->
    <cone name="solid_pmt_housing" rmin1="42"  rmax1="45.0" rmin2="42" rmax2="45.0"  z="213.0" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>
	<cone name="solid_pmt_housing_lid" rmin1="0"  rmax1="46.0" rmin2="0" rmax2="46.0"  z="3.0" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>

    <!--Light Tight Housing-->
    <box name="solid_DBM_plastic_box" lunit="mm" x="95" y="105" z="205"/>
    <tube name="solid_DBM_sub_tube" lunit="mm" rmin="0" rmax="39" z="105" deltaphi="2*pi" startphi="0" aunit="rad" />

    <subtraction name="solid_DBM_plastic_box_sub" >
        <first ref="solid_DBM_plastic_box"/>
        <second ref="solid_DBM_sub_tube"/>
        <position name="solid_DBM_plastic_box_sub_pos" unit="mm" x="0" y="2" z="53.52" />
        <rotation name="solid_DBM_plastic_box_sub_rot" unit="deg" x="90" y="0" z="0" />
    </subtraction>

</solids>


<structure>


    <volume name="DBM_quartz_logic_0">
        <materialref ref="Quartz"/>
        <solidref ref = "solid_DBM_radiator_quartz"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="81000"/>
    </volume>

    <volume name="DBM_quartzpmt_cathode_logic_0">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="82000"/>
