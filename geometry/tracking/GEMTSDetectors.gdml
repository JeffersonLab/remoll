    </volume>

    <volume name="GEM_detector_log_22">
      <materialref ref="ArCO2"/>
      <solidref   ref="GEM_detector_solid_plane34"/>
      <auxiliary auxtype="SensDet" auxvalue="GEMSD"/>
      <auxiliary auxtype="DetNo"  auxvalue="322"/>
      <auxiliary auxtype="Color"  auxvalue="green"/>
    </volume>

    <volume name="GEM_detector_log_23">
      <materialref ref="ArCO2"/>
      <solidref   ref="GEM_detector_solid_plane34"/>
      <auxiliary auxtype="SensDet" auxvalue="GEMSD"/>
      <auxiliary auxtype="DetNo"  auxvalue="323"/>
      <auxiliary auxtype="Color"  auxvalue="green"/>
    </volume>

    <volume name="GEM_detector_log_24">
      <materialref ref="ArCO2"/>
      <solidref   ref="GEM_detector_solid_plane34"/>
      <auxiliary auxtype="SensDet" auxvalue="GEMSD"/>
      <auxiliary auxtype="DetNo"  auxvalue="324"/>
      <auxiliary auxtype="Color"  auxvalue="green"/>
    </volume>

    <volume name="GEM_detector_log_25">
      <materialref ref="ArCO2"/>
      <solidref   ref="GEM_detector_solid_plane34"/>
      <auxiliary auxtype="SensDet" auxvalue="GEMSD"/>
      <auxiliary auxtype="DetNo"  auxvalue="325"/>
      <auxiliary auxtype="Color"  auxvalue="green"/>
    </volume>

    <volume name="GEM_detector_log_26">
      <materialref ref="ArCO2"/>
      <solidref   ref="GEM_detector_solid_plane34"/>
      <auxiliary auxtype="SensDet" auxvalue="GEMSD"/>
      <auxiliary auxtype="DetNo"  auxvalue="326"/>
      <auxiliary auxtype="Color"  auxvalue="green"/>
    </volume>

    <volume name="GEM_detector_log_27">
      <materialref ref="ArCO2"/>
      <solidref   ref="GEM_detector_solid_plane34"/>
      <auxiliary auxtype="SensDet" auxvalue="GEMSD"/>
      <auxiliary auxtype="DetNo"  auxvalue="327"/>
      <auxiliary auxtype="Color"  auxvalue="green"/>
    </volume>

    <!-- WORLD: GEMS + trig scint on planes 0 and 3 -->
    <volume name="GEM_world_log">
      <materialref ref="G4_AIR"/>
      <solidref   ref="GEM_world_solid"/>

      <!-- plane 0: GEMS 1..7 -->
      <loop for="j" from="0" to="6" step="1">
        <physvol name="GEM_plane0_[j+1]">
          <volumeref ref="GEM_detector_log[j + 1]"/>
          <rotation  z="(-j)*360./7 - 90 + n_rots_01*360./28" unit="deg"/>
          <positionref ref="GEM_trackingPlane_pos_0" unit="mm"/>
        </physvol>
      </loop>

      <!-- plane 0: trig scint right after plane 0 GEMS -->
      <loop for="j" from="0" to="6" step="1">
        <physvol name="TRIG_plane0_[j+1]">
          <volumeref ref="trig_scint_sector_log"/>
          <rotation  z="(-j)*360./7 - 90 + n_rots_01*360./28" unit="deg"/>
          <positionref ref="TRIGSCINT_trackingPlane_pos_0" unit="mm"/>
        </physvol>
      </loop>

      <!-- plane 1: GEMS 8..14 -->
      <loop for="j" from="0" to="6" step="1">
        <physvol name="GEM_plane1_[j+1]">
          <volumeref ref="GEM_detector_log[7 + j + 1]"/>
          <rotation  z="(-j)*360./7 - 90 + n_rots_01*360./28" unit="deg"/>
          <positionref ref="GEM_trackingPlane_pos_1" unit="mm"/>
        </physvol>
      </loop>

      <!-- plane 2: GEMS 15..21 -->
      <loop for="j" from="0" to="6" step="1">
        <physvol name="GEM_plane2_[j+1]">
          <volumeref ref="GEM_detector_log[14 + j + 1]"/>
          <rotation  z="(-j)*360./7 - 90 + n_rots_23*360./28" unit="deg"/>
          <positionref ref="GEM_trackingPlane_pos_2" unit="mm"/>
        </physvol>
      </loop>

      <!-- plane 3: trig scint just upstream of GEM plane 3 -->
      <loop for="j" from="0" to="6" step="1">
        <physvol name="TRIG_plane3_[j+1]">
          <volumeref ref="trig_scint_sector_log"/>
          <rotation  z="(-j)*360./7 - 90 + n_rots_23*360./28" unit="deg"/>
          <positionref ref="TRIGSCINT_trackingPlane_pos_3" unit="mm"/>
        </physvol>
      </loop>

      <!-- plane 3: GEMS 22..28 -->
      <loop for="j" from="0" to="6" step="1">
        <physvol name="GEM_plane3_[j+1]">
          <volumeref ref="GEM_detector_log[21 + j + 1]"/>
          <rotation  z="(-j)*360./7 - 90 + n_rots_23*360./28" unit="deg"/>
          <positionref ref="GEM_trackingPlane_pos_3" unit="mm"/>
        </physvol>
      </loop>

      <auxiliary auxtype="Alpha" auxvalue="0.0"/>
    </volume>

  </structure>

  <setup name="Default" version="1.0">
    <world ref="GEM_world_log"/>
  </setup>

</gdml>

