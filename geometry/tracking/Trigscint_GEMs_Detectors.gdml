    </volume>



    <volume name="GEM_world_log">
        <materialref ref="G4_AIR"/>
        <solidref ref="GEM_world_solid"/>
        
         <!--Insertion by YA -->

    <!-- plane 0: KEEP original GEMs 1..7 -->
    <loop for="j" from="0" to="6" step="1">
      <physvol name="GEM_plane0_[j+1]">
        <!-- GEMs 1..7 -->
        <volumeref ref="GEM_detector_log[j + 1]"/>
        <rotation z="(-j)*360./7 + 90" unit="deg"/>
        <positionref ref="GEM_trackingPlane_pos_0" unit="m"/>
      </physvol>
    </loop>

    
     <!-- plane 0: Add TrigScint to original GEMs 1..7 -->
    <loop for="j" from="0" to="6" step="1">
      <physvol name="TRIG_plane0_[j+1]">
        <volumeref ref="trig_scint_sector_log"/>
        <rotation z="(-j)*360./7 + 90" unit="deg"/>
        <positionref ref="TRIGSCINT_trackingPlane_pos_0" unit="m"/>
      </physvol>
    </loop>
    
    <!-- plane 1: Keep Original GEMS 8 .. 14 -->
    <loop for="j" from="0" to="6" step="1">
      <physvol name="GEM_plane1_[j+1]">
        <volumeref ref="GEM_detector_log[7 + j + 1]"/>
        <rotation z="(-j)*360./7 + 90" unit="deg"/>
        <positionref ref="GEM_trackingPlane_pos_1" unit="m"/>
      </physvol>
    </loop>
    
    <!-- plane 2: Keep Original GEMS 15 .. 21 -->
    <loop for="j" from="0" to="6" step="1">
      <physvol name="GEM_plane1_[j+1]">
        <volumeref ref="GEM_detector_log[14 + j + 1]"/>
        <rotation z="(-j)*360./7 + 90" unit="deg"/>
        <positionref ref="GEM_trackingPlane_pos_2" unit="m"/>
      </physvol>
    </loop>



    <!-- plane 3: KEEP original GEMs 22-28 -->
    <loop for="j" from="0" to="6" step="1">
      <physvol name="GEM_plane3_[j+1]">
        <!-- GEMs 22 .. 28 -->
        <volumeref ref="GEM_detector_log[21 + j + 1]"/>
        <rotation z="(-j)*360./7 + 90" unit="deg"/>
        <positionref ref="GEM_trackingPlane_pos_3" unit="m"/>
      </physvol>
    </loop>
    
    
     <!-- plane 3: ALSO ADD TrigScint (wrapped)  before GEMS in this plane-->
    <loop for="j" from="0" to="6" step="1">
      <physvol name="TRIG_plane3_[j+1]">
        <volumeref ref="trig_scint_sector_log"/>
        <rotation z="(-j)*360./7 + 90" unit="deg"/>
        <positionref ref="TRIGSCINT_trackingPlane_pos_3" unit="m"/>
      </physvol>
    </loop>

    <auxiliary auxtype="Alpha" auxvalue="0.0"/>

  </volume>

         
        
      <!-- 
       <loop for="k" from="0" to="3" step="1">
            <loop for="j" from="0" to="6" step="1">
                <physvol name="GEM_detector_sector_phys[k+1][j+1]">
                    <volumeref ref="GEM_detector_log[k*7 + j + 1]"/>
                    <rotation z="(-j)*360./7 + 90" unit="deg"/>
                    <positionref ref="GEM_trackingPlane_pos[k+1]" unit="m"/>
                </physvol>
            </loop>
        </loop>
       --> 
  

 </structure>


<setup name="Default" version="1.0">
    <world ref="GEM_world_log"/>
</setup>

