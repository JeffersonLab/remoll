<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE gdml [
	<!ENTITY matrices SYSTEM "showerMaxMatrices.xml">
	<!ENTITY materials SYSTEM "showerMaxMaterials.xml">
    ]>

<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">


<define>
    <!-- Radiator and Light Guide Parameters-->
    <constant name="thickness" value="10" />
    <constant name="offset" value="60" />

    <constant name="d3" value="30" />  <!--Z distance from PMT to Quartz-->
    <constant name="chamfer" value="70" />
    <constant name="length" value="250" />
    <constant name="height" value="165" />
    <constant name="detBox_r" value="1033.5 + height/2"/> <!--Radial location of LAM radiator from Moller-doc-793-v2-->

    &matrices;
</define>

&materials;

<solids>
    <!--Enclosing voumme for the LAM system-->
    <cone name="solidLAM_bounding_box" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin1="1010" rmax1="1315" rmin2="1019" rmax2="1315" z="150"/>
    <cone name="solidLAM_bounding_box_1" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin1="1.01*1146.35" rmax1="1315" rmin2="1.01*1146.35" rmax2="1315" z="125"/>
    <cone name="solidCollar2_InnerRing" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin1="0.99*1010" rmax1="1.01*1146.35" rmin2="0.99*1019" rmax2="1.01*1146.35" z="1.01*150"/> <!--the information of the inner ring is taken from Chandan Ghosh-->
    <cone name="solidCollar2_OuterRing" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin1="0.99*1120.95" rmax1="1.01*1315" rmin2="0.99*1120.95" rmax2="1.01*1315" z="1.01*150"/><!--the information of the outer ring is taken from Moller-doc-793-v2-->
    <cone name="solidLAM_singleDet_bounding_box" lunit="mm" aunit="rad" startphi="-pi/7" deltaphi="2*pi/7" rmin1="1.01*1010" rmax1="0.99*1315" rmin2="1.01*1019" rmax2="0.99*1315" z="0.99*150"/>
    <cone name="solidLAM_singleDet_bounding_box_1" lunit="mm" aunit="rad" startphi="-pi/7" deltaphi="2*pi/7" rmin1="1.01*1146.35" rmax1="1315" rmin2="1.01*1146.35" rmax2="1315" z="125"/>
    <cone name="solidCollar2_InnerRing_scaled2" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin1="0.99*1010" rmax1="1.01*1146.35" rmin2="0.99*1019" rmax2="1.01*1146.35" z="1.01*150"/> <!--the information of the inner ring is taken from Chandan Ghosh-->
    <cone name="solidCollar2_OuterRing_scaled2" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin1="0.99*1120.95" rmax1="1.01*1315" rmin2="0.99*1120.95" rmax2="1.01*1315" z="1.01*150"/><!--the information of the outer ring is taken from Moller-doc-793-v2-->


    <union name="solidLAM_bounding_box_union">
        <first ref="solidLAM_bounding_box"/>
        <second ref="solidLAM_bounding_box_1"/>
        <position name="LAM_bounding_box_union_pos" x="0" y="0" z="137.5"/>
    </union>

    <subtraction name="solidLAM_bounding_box_sub1">
        <first ref="solidLAM_bounding_box_union"/>
        <second ref="solidCollar2_InnerRing"/>
        <position name="LAM_bounding_box_sub1_pos" x="0" y="0" z="50"/>
    </subtraction>

    <subtraction name="solidLAM_bounding_box_sub2">
        <first ref="solidLAM_bounding_box_sub1"/>
        <second ref="solidCollar2_OuterRing"/>
        <position name="LAM_bounding_box_sub2_pos" x="0" y="0" z="-150"/>
    </subtraction>

    <union name="solidLAM_singleDet_bounding_box_union">
        <first ref="solidLAM_singleDet_bounding_box"/>
        <second ref="solidLAM_singleDet_bounding_box_1"/>
        <position name="LAM_bounding_box_union_pos" x="0" y="0" z="125"/>
    </union>

    <subtraction name="solidLAM_singleDet_bounding_box_sub1">
        <first ref="solidLAM_singleDet_bounding_box_union"/>
        <second ref="solidCollar2_InnerRing_scaled2"/>
        <position name="LAM_singleDet_bounding_box_sub1_pos" x="0" y="0" z="50"/>
    </subtraction>

    <subtraction name="solidLAM_singleDet_bounding_box_sub2">
        <first ref="solidLAM_singleDet_bounding_box_sub1"/>
        <second ref="solidCollar2_OuterRing_scaled2"/>
        <position name="LAM_singleDet_bounding_box_sub2_pos" x="0" y="0" z="-150"/>
    </subtraction>

    <!--Radiator-->
    <box lunit="mm" name="radiator_quartz" x="length" y="height" z="thickness"/>

    <box lunit="mm" name="radiator_quartz_cut2" x="length" y="5" z="thickness"/>

    <arb8 name="radiator_cut" v1x="0" v1y="-1" v2x="0" v2y="11" v3x="chamfer + 1" v3y="11"
        v4x="chamfer + 1" v4y="-1" v5x="0" v5y="11" v6x="0" v6y="11" v7x="chamfer + 1" v7y="11"
        v8x="chamfer + 1" v8y="11" dz="12/2" lunit= "mm"/>

    <subtraction name="radiator_1_cut" >
        <first ref="radiator_quartz"/>
        <second ref="radiator_cut"/>
        <position name="right_rad_cut_pos" unit="mm" x="length/2 - chamfer" y="height/2 - 10" z="0" />
        <rotation name="right_rad_cut_rot" unit="deg" x="0" y="0" z="0" />
        </subtraction>

    <subtraction name="radiator" >
        <first ref="radiator_1_cut"/>
        <second ref="radiator_cut"/>
        <position name="left_rad_cut_pos" unit="mm" x="-length/2 - 1 " y="height/2 - 10" z="0" />
        <rotation name="left_rad_cut_rot" unit="deg" x="0" y="0" z="0" />
        </subtraction>

    <!--PMTs-->
    <tube name="solid_pmt_window" rmin="0" rmax="38.1" z="3.0" deltaphi="2*pi" startphi="0" aunit="rad" lunit="mm"/>
    <tube name="solid_pmt_cathode" rmin="0" rmax="38.1" z="3e-06" deltaphi="2*pi" startphi="0" aunit="rad" lunit="mm"/>

    <!--PMT Housing-->
    <cone name="solid_pmt_housing" rmin1="42"  rmax1="45.0" rmin2="42" rmax2="45.0"  z="213.0" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>
	<cone name="solid_pmt_housing_lid" rmin1="0"  rmax1="48.0" rmin2="0" rmax2="48.0"  z="3.0" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>

    <!--Plastic Enclosure solids-->
    <box lunit="mm" name="frontPlate_solid" x="length" y="height" z="0.5"/>
    <box lunit="mm" name="backPlate_solid" x="length" y="height - 10" z="0.5"/>
    <box lunit="mm" name="backTopPlate_solid" x="length - 2*chamfer - 0.5/2" y="10" z="0.5"/>
    <box lunit="mm" name="topPlate_solid" x="thickness" y="length - (2*chamfer) - 1.4" z="0.5"/>
    <box lunit="mm" name="botPlate_solid" x="thickness" y="length" z="0.5"/>
    <box lunit="mm" name="sidePlate_solid" x="thickness" y="height -10" z="0.5"/>
    <box lunit="mm" name="bunnyEar_solid" x="chamfer" y="48.8" z="0.5"/>
    <box lunit="mm" name="bunnyEarOutsidePlate_solid" x="thickness + d3" y="48.4 + 10" z="0.5"/>
    <box lunit="mm" name="bunnyEarInsidePlate_solid" x="thickness + d3" y="48.4" z="0.5"/>
    <box lunit="mm" name="bunnyEarTopPlate_solid" x="thickness + d3" y="chamfer" z="0.5"/>
    <box lunit="mm" name="bunnyEarBottomPlate_solid" x="d3" y="chamfer" z="0.5"/>

</solids>


<structure>

    <!--LOGIC VOLUMES-->
    <volume name="radiator_quartz_logic_00" >
        <materialref ref="Quartz" />
        <solidref ref="radiator" />
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="80001"/>
        </volume>

    <volume name="pmt1_cathode_logic_00" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80002"/>
        </volume>

    <volume name="pmt2_cathode_logic_00" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80003"/>
        </volume>

    <volume name="radiator_quartz_logic_01" >
        <materialref ref="Quartz" />
        <solidref ref="radiator" />
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="80101"/>
        </volume>

    <volume name="pmt1_cathode_logic_01" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80102"/>
        </volume>

    <volume name="pmt2_cathode_logic_01" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80103"/>
        </volume>

    <volume name="radiator_quartz_logic_02" >
        <materialref ref="Quartz" />
        <solidref ref="radiator" />
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="80201"/>
        </volume>

    <volume name="pmt1_cathode_logic_02" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80202"/>
        </volume>

    <volume name="pmt2_cathode_logic_02" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80203"/>
        </volume>

    <volume name="radiator_quartz_logic_03" >
        <materialref ref="Quartz" />
        <solidref ref="radiator" />
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="80301"/>
        </volume>

    <volume name="pmt1_cathode_logic_03" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80302"/>
        </volume>

    <volume name="pmt2_cathode_logic_03" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80303"/>
        </volume>

    <volume name="radiator_quartz_logic_04" >
        <materialref ref="Quartz" />
        <solidref ref="radiator" />
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="80401"/>
        </volume>

    <volume name="pmt1_cathode_logic_04" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80402"/>
        </volume>

    <volume name="pmt2_cathode_logic_04" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80403"/>
        </volume>

    <volume name="radiator_quartz_logic_05" >
        <materialref ref="Quartz" />
        <solidref ref="radiator" />
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="80501"/>
        </volume>

    <volume name="pmt1_cathode_logic_05" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80502"/>
        </volume>

    <volume name="pmt2_cathode_logic_05" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80503"/>
        </volume>

    <volume name="radiator_quartz_logic_06" >
        <materialref ref="Quartz" />
        <solidref ref="radiator" />
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="80601"/>
        </volume>

    <volume name="pmt1_cathode_logic_06" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80602"/>
        </volume>

    <volume name="pmt2_cathode_logic_06" >
        <materialref ref="Cathode" />
        <solidref ref="solid_pmt_cathode" />
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorPMT" />
		<auxiliary auxtype="DetNo" auxvalue="80603"/>
        </volume>

	<volume name="pmt1_window_logic" >
        <materialref ref="Quartz" />
        <solidref ref="solid_pmt_window" />
        <auxiliary auxtype="Color" auxvalue="blue"/>
        </volume>

    <volume name="pmt2_window_logic" >
        <materialref ref="Quartz" />
        <solidref ref="solid_pmt_window" />
        <auxiliary auxtype="Color" auxvalue="blue"/>
        </volume>

    
    <volume name="logic_pmt_housing">
		<materialref ref="G4_Al"/>
		<solidref ref="solid_pmt_housing"/>
		<auxiliary auxtype="Color" auxvalue="grey"/>
		<auxiliary auxtype="Alpha" auxvalue="0.5"/>
	    </volume>

    <volume name="logic_pmt_housing_lid">
		<materialref ref="G4_Al"/>
		<solidref ref="solid_pmt_housing_lid"/>
		<auxiliary auxtype="Color" auxvalue="grey"/>
        <auxiliary auxtype="Alpha" auxvalue="0.5"/>
	    </volume>
    
                    <!--Plastic Enclosure-->
    <volume name="enclosure_backPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="backPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>
    
    <volume name="enclosure_backTopPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="backTopPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="enclosure_frontPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="frontPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="enclosure_topPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="topPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="enclosure_rightPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="sidePlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="enclosure_leftPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="sidePlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="enclosure_botPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="botPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="enclosure_topPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="topPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="bunnyEar_logic">
        <materialref ref="Nylon"/>
        <solidref ref="bunnyEar_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="bunnyEarOutsidePlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="bunnyEarOutsidePlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>
    
    <volume name="bunnyEarInsidePlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="bunnyEarInsidePlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="bunnyEarTopPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="bunnyEarTopPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>

    <volume name="bunnyEarBottomPlate_logic">
        <materialref ref="Nylon"/>
        <solidref ref="bunnyEarBottomPlate_solid"/>
        <auxiliary auxtype="Color" auxvalue="red"/>
        </volume>





    <!--Single Detector Logic Volume-->
    <volume name="logic_LAM_singledet_0">
		<materialref ref="Air"/>
		<solidref ref="solidLAM_singleDet_bounding_box_sub2"/>
        <auxiliary auxtype="Alpha" auxvalue="0.0"/>

        <physvol name="radiator_quartz_phys_00">
            <volumeref ref="radiator_quartz_logic_00" />
            <position name="radiator_quartz_pos" unit="mm" x="detBox_r" y="0" z="0 - 65" />
            <rotation name="radiator_quartz_rot" unit="deg" x="0" y="180" z="270" />
            </physvol>
        
        <physvol name="pmt1_cathode_phys_00">
            <volumeref ref="pmt1_cathode_logic_00" />
            <position name="pmt1_cathode_pos" unit="mm" x="detBox_r + height/2 + 38.1/2" y="length/2-chamfer/2" z="thickness/2 +3+3e-06/2.0 + d3 - 65" />
            <rotation name="pmt1_cathode_rot" unit="radian" x="0" y="0" z="0" />
            </physvol>

        <physvol name="pmt2_cathode_phys_00">
            <volumeref ref="pmt2_cathode_logic_00" />
            <position name="pmt2_cathode_pos" unit="mm" x="detBox_r + height/2 + 38.1/2" y="-(length/2-chamfer/2)" z="thickness/2 +3+3e-06/2.0  + d3 - 65" />
            <rotation name="pmt2_cathode_rot" unit="radian" x="0" y="0" z="0" />
            </physvol>

         <physvol name="pmt1_window_phys">
            <volumeref ref="pmt1_window_logic" />
            <position name="pmt1_window_pos" unit="mm" x="detBox_r + height/2 + 38.1/2" y="length/2-chamfer/2" z="thickness/2 + 3.0/2.0 + d3 - 65" />
            <rotation name="pmt1_window_rot" unit="radian" x="0" y="0" z="0" />
            </physvol>

        <physvol name="pmt2_window_phys">
            <volumeref ref="pmt2_window_logic" />
            <position name="pmt2_window_pos" unit="mm" x="detBox_r + height/2 + 38.1/2" y="-(length/2-chamfer/2)" z="thickness/2 +3.0/2.0 + d3 - 65" />
            <rotation name="pmt2_window_rot" unit="radian" x="0" y="0" z="0" />
            </physvol>

        <physvol name="pmt1_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_logic_pmt1_housing" x="detBox_r + height/2 + 38.1/2" y="length/2-chamfer/2" z="thickness/2 + 3.0/2.0 + d3 - 65 + 213/2"/>
			<rotation name="rot_logic_pmt1_housing" unit="radian" x="0" y="0" z="0"/>
		    </physvol>

		<physvol name="pmt1_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_logic_pmt1_housing_lid" x="detBox_r + height/2 + 38.1/2" y="length/2-chamfer/2" z="thickness/2 + 3.0/2.0 + d3 - 65 + 213 + 3/2"/>
			<rotation name="rot_logic_pmt1_housing_lid" unit="radian" x="0" y="0" z="0" />
		    </physvol>

        <physvol name="pmt2_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_logic_pmt2_housing" x="detBox_r + height/2 + 38.1/2" y="-(length/2-chamfer/2)" z="thickness/2 + 3.0/2.0 + d3 - 65 + 213/2"/>
			<rotation name="rot_logic_pmt2_housing" unit="radian" x="0" y="0" z="0"/>
		    </physvol>

		<physvol name="pmt2_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_logic_pmt2_housing_lid" x="detBox_r + height/2 + 38.1/2" y="-(length/2-chamfer/2)" z="thickness/2 + 3.0/2.0 + d3 - 65 + 213 + 3/2"/>
			<rotation name="rot_logic_pmt2_housing_lid" unit="radian" x="0" y="0" z="0" />
		    </physvol>


        <!--Plastic Enclosure-->

        <physvol name="enclosure_backPlate_phys">
            <volumeref ref="enclosure_backPlate_logic" />
            <position name="backPlate_pos" unit="mm" x="-5 + detBox_r" y="0" z="thickness/2 + 0.7/2 - 65" />
            <rotation name="backPlate_rot" unit="deg" x="0" y="0" z="90" />
            </physvol>
        
